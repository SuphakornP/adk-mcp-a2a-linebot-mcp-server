# Google Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY="FILL_HERE"

# Model Configuration
MODEL_ID=gemini-2.5-flash

# Google Cloud + Maps (Required for 8_agent_with_skill/marathon_planner_agent)
GOOGLE_CLOUD_PROJECT="FILL_HERE"
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MAPS_API_KEY="FILL_HERE"

# Optional Agent Engine / OpenTelemetry settings for the Marathon Planner.
# Secure defaults: enable intentionally only after reviewing data/privacy policy.
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=false
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# LINE Bot Configuration (Required for LINE Bot MCP Server)
CHANNEL_ACCESS_TOKEN="FILL_HERE"
DESTINATION_USER_ID="FILL_HERE"

# Pinecone Configuration (Required for Pinecone RAG)
PINECONE_API_KEY="FILL_HERE"

# OPENAI API KEY
OPENAI_API_KEY="FILL_HERE"
OPENAI_MODEL_ID=gpt-5-mini-2025-08-07

# BEDROCK AWS
BEDROCK_ACCESS_KEY_ID="FILL_HERE"
BEDROCK_SECRET_ACCESS_KEY="FILL_HERE"
AWS_REGION_NAME=us-west-2
CLAUDE_MODEL_ID=global.anthropic.claude-sonnet-4-20250514-v1:0

# LangSmith - Observability and Tracing for Google ADK
# Get your API key from: https://smith.langchain.com/settings
LANGSMITH_API_KEY="FILL_HERE"
LANGSMITH_PROJECT="adk-mcp-a2a-linebot-poc"
